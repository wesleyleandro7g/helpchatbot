---
// CTA Component for Help Chat Bot
import TechGrid from './TechGrid.astro';
---

<section class="cta-section">
  <!-- Interactive design blobs -->
  <TechGrid type="waves" opacity={0.12} color="var(--color-primary)" animate={true} />
  <div class="glow-effect" style="top: -20%; left: 30%; width: 500px; height: 500px; opacity: 0.15; background: radial-gradient(circle, rgba(2, 158, 248, 0.25) 0%, rgba(6, 55, 186, 0.1) 60%, rgba(0,0,0,0) 100%);"></div>

  <div class="container">
    <div class="cta-card glass-card reveal-on-scroll tech-corners">
      <TechGrid type="cross" opacity={0.06} color="var(--color-secondary)" />
      <div class="cta-content">
        <h2>Pronto para revolucionar o atendimento do seu negócio?</h2>
        <p>
          Fale com um especialista hoje mesmo. Nós desenhamos os fluxos de automação perfeitos para a sua clínica ou empresa, cuidamos de toda a integração e colocamos para rodar com rapidez.
        </p>

        <div class="cta-buttons">
          <a href="https://wa.me/5538998591036?text=Olá,%20vi%20o%20site%20e%20gostaria%20de%20um%20orçamento!" target="_blank" class="btn-whatsapp cta-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            <span>Falar com um Especialista no WhatsApp</span>
          </a>
        </div>

        <div class="cta-meta-badge">
          <span>✓ Configuração rápida</span>
          <span>✓ Sem taxa de cancelamento</span>
          <span>✓ Parceiro Meta</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 100px 0;
    background: var(--color-bg);
    transition: background-color 0.3s ease;
  }

  .cta-card {
    padding: 80px 40px;
    text-align: center;
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: radial-gradient(circle at center, rgba(6, 55, 186, 0.12) 0%, rgba(3, 7, 18, 0) 70%), var(--color-glass-bg);
  }

  html[data-theme="light"] .cta-card {
    background: var(--color-glass-bg);
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }

  .cta-content h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 24px;
    line-height: 1.2;
  }

  .cta-content p {
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 40px;
    color: var(--color-text-muted);
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    margin-bottom: 30px;
  }

  .cta-btn {
    padding: 18px 36px;
    font-size: 1.1rem;
    box-shadow: 0 15px 35px rgba(3, 173, 61, 0.35);
  }

  .cta-meta-badge {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 24px;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .cta-card {
      padding: 50px 20px;
    }
    
    .cta-meta-badge {
      gap: 12px;
      flex-direction: column;
    }
  }
</style>

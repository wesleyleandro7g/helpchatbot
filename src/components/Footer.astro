---
// Footer Component for Help Chat Bot
import TechGrid from './TechGrid.astro';
---

<footer class="main-footer">
  <TechGrid type="dots" opacity={0.04} color="var(--color-secondary)" />
  <div class="container footer-grid">
    <!-- Brand column -->
    <div class="footer-brand">
      <div class="footer-logo-container">
        <img src="/logo-white.webp" alt="Help Chat Bot Logo" class="footer-logo logo-dark" />
        <img src="/logo.webp" alt="Help Chat Bot Logo" class="footer-logo logo-light" />
      </div>
      <p class="footer-bio">
        Somos especialistas em automação inteligente e queremos te ajudar a melhorar seu atendimento. 🚀 WhatsApp, Instagram e mais em um só lugar.
      </p>
      
      <div class="footer-socials">
        <a href="https://www.instagram.com/helpchatbot/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61571708781557" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"/>
          </svg>
        </a>
      </div>

      <div class="meta-partner-footer">
        <span class="meta-icon">♾️</span>
        <span>Parceiro Oficial Meta</span>
      </div>
    </div>

    <!-- Links column -->
    <div class="footer-links">
      <h4>Navegação</h4>
      <a href="/" class="foot-link">Início</a>
      <a href="/calculadora" class="foot-link">Calculadora</a>
      <a href="/#beneficios" class="foot-link">Benefícios</a>
      <a href="/#permissoes" class="foot-link">Permissões</a>
      <a href="/#clinicas" class="foot-link">Clínicas & Laboratórios</a>
    </div>

    <!-- Systems column -->
    <div class="footer-links">
      <h4>Acesso Rápido</h4>
      <a href="https://zap.speakr.com.br/" target="_blank" rel="noopener noreferrer" class="foot-link">Plataforma ChatBOT</a>
      <a href="https://helpdesk-rouge-xi.vercel.app/" target="_blank" rel="noopener noreferrer" class="foot-link">Disparo por Planilha</a>
    </div>

    <!-- Contact column -->
    <div class="footer-contact">
      <h4>Fale Conosco</h4>
      <ul class="contact-list">
        <li>
          <span class="icon">💬</span>
          <a href="https://wa.me/5538998591036" target="_blank" class="contact-link">(38) 9 9859-1036</a>
        </li>
        <li>
          <span class="icon">✉️</span>
          <a href="mailto:contato@helpchatbot.com.br" class="contact-link">contato@helpchatbot.com.br</a>
        </li>
        <li>
          <span class="icon">📍</span>
          <span>Montes Claros - MG</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-flex">
      <p>&copy; {new Date().getFullYear()} Help Chat Bot. Todos os direitos reservados.</p>
      <div class="footer-credits">
        <span>Desenvolvido por <a href="https://wesleyleandro.com/en" target="_blank" rel="noopener noreferrer" class="credits-link">Wesley Leandro</a> 🚀</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .main-footer {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    padding-top: 80px;
    color: var(--color-text-muted);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding-bottom: 60px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .footer-socials {
    display: flex;
    gap: 12px;
    margin-top: 5px;
    margin-bottom: 5px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-muted);
    transition: var(--transition-smooth);
  }

  html[data-theme="light"] .social-link {
    background: rgba(15, 23, 42, 0.04);
  }

  .social-link:hover {
    background: var(--color-secondary);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .footer-logo-container {
    display: flex;
    align-items: center;
  }

  .footer-logo {
    height: 48px;
    width: auto;
    align-self: flex-start;
    object-fit: contain;
  }

  /* Logo swap logic */
  .logo-light {
    display: none;
  }

  html[data-theme="light"] .logo-dark {
    display: none;
  }

  html[data-theme="light"] .logo-light {
    display: block;
  }

  .footer-bio {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .meta-partner-footer {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(2, 158, 248, 0.05);
    border: 1px solid rgba(2, 158, 248, 0.15);
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-secondary);
    align-self: flex-start;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links h4, .footer-contact h4 {
    color: var(--color-heading);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 8px;
    transition: color 0.3s ease;
  }

  .foot-link {
    font-size: 0.95rem;
    transition: var(--transition-smooth);
  }

  .foot-link:hover {
    color: var(--color-heading);
    transform: translateX(4px);
  }

  .contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
  }

  .contact-list .icon {
    font-size: 1.1rem;
    opacity: 0.8;
  }

  .contact-link {
    transition: var(--transition-smooth);
  }

  .contact-link:hover {
    color: var(--color-heading);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 30px 0;
    font-size: 0.85rem;
  }

  .footer-bottom-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .credits-link {
    color: var(--color-secondary);
    font-weight: 600;
    transition: var(--transition-smooth);
  }

  .credits-link:hover {
    color: var(--color-secondary);
    opacity: 0.8;
    text-decoration: underline;
  }

  @media (max-width: 991px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    
    .footer-bottom-flex {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

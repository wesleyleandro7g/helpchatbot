---
// Header Component for Help Chat Bot with Light/Dark Theme Toggle
---

<header class="main-header">
  <div class="container header-container">
    <a href="#" class="logo-link">
      <img src="/logo-white.webp" alt="Help Chat Bot Logo" class="logo-img logo-dark" />
      <img src="/logo.webp" alt="Help Chat Bot Logo" class="logo-img logo-light" />
    </a>
    
    <div class="header-right">
      <button class="theme-toggle-btn" id="themeToggleBtn" aria-label="Alternar tema">
        <!-- Sun Icon (shows in dark theme) -->
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <!-- Moon Icon (shows in light theme) -->
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <button class="menu-toggle" aria-label="Abrir menu" id="menuToggle">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>

      <nav class="nav-menu" id="navMenu">
        <a href="#" class="nav-link">Início</a>
        <a href="#beneficios" class="nav-link">Benefícios</a>
        <a href="#permissoes" class="nav-link">Permissões</a>
        <a href="#clinicas" class="nav-link">Clínicas</a>
        <a href="https://zap.speakr.com.br/" target="_blank" rel="noopener noreferrer" class="nav-btn-mobile btn-primary">Acessar Plataforma</a>
        <a href="https://helpdesk-rouge-xi.vercel.app/" target="_blank" rel="noopener noreferrer" class="nav-btn-mobile btn-secondary-outline">Disparo via Planilha</a>
      </nav>

      <div class="header-cta">
        <a href="https://helpdesk-rouge-xi.vercel.app/" target="_blank" rel="noopener noreferrer" class="btn-secondary-outline">
          Disparo via Planilha
        </a>
        <a href="https://zap.speakr.com.br/" target="_blank" rel="noopener noreferrer" class="btn-primary">
          Acessar Plataforma
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Header specific background variables */
  :root {
    --color-header-bg: rgba(3, 7, 18, 0.6);
    --color-header-scrolled-bg: rgba(3, 7, 18, 0.85);
  }

  html[data-theme="light"] {
    --color-header-bg: rgba(248, 250, 252, 0.7);
    --color-header-scrolled-bg: rgba(248, 250, 252, 0.92);
  }

  .main-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: var(--color-header-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: var(--transition-smooth);
  }

  .main-header.scrolled {
    background: var(--color-header-scrolled-bg);
    padding: 12px 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  html[data-theme="dark"] .main-header.scrolled {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
    transition: var(--transition-smooth);
  }

  .logo-link {
    display: flex;
    align-items: center;
  }

  .logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
    transition: var(--transition-smooth);
  }

  .main-header.scrolled .logo-img {
    height: 40px;
  }

  /* Logo swap logic */
  .logo-light {
    display: none;
  }

  html[data-theme="light"] .logo-dark {
    display: none;
  }

  html[data-theme="light"] .logo-light {
    display: block;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: var(--transition-smooth);
    position: relative;
    padding: 8px 0;
  }

  .highlight-link {
    color: var(--color-secondary);
  }

  .highlight-link:hover {
    color: var(--color-heading);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-secondary), var(--color-primary));
    transition: var(--transition-smooth);
  }

  .nav-link:hover {
    color: var(--color-heading);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-btn-mobile {
    display: none !important;
  }

  .btn-secondary-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
    transition: var(--transition-smooth);
    cursor: pointer;
    text-decoration: none;
  }

  .btn-secondary-outline:hover {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
    transform: translateY(-2px);
  }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-cta .btn-primary {
    padding: 10px 20px;
    font-size: 0.9rem;
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .header-cta .btn-secondary-outline {
    padding: 8px 18px;
    font-size: 0.9rem;
    border-radius: var(--radius-md);
  }

  /* Theme Toggle Button Styling */
  .theme-toggle-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-smooth);
    z-index: 1002;
  }

  .theme-toggle-btn:hover {
    background: var(--color-btn-sec-bg);
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }

  /* Show sun, hide moon in dark mode */
  .sun-icon { display: block; }
  .moon-icon { display: none; }

  /* Show moon, hide sun in light mode */
  html[data-theme="light"] .sun-icon { display: none; }
  html[data-theme="light"] .moon-icon { display: block; }

  /* Hamburger Menu for Mobile */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 26px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 1001;
  }

  .menu-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--color-heading);
    border-radius: 2px;
    transition: var(--transition-smooth);
  }

  @media (max-width: 991px) {
    .menu-toggle {
      display: flex;
    }

    .nav-menu {
      position: fixed;
      top: 0;
      right: -100%;
      width: 80%;
      max-width: 350px;
      height: 100vh;
      background: var(--color-bg-alt);
      border-left: 1px solid var(--color-border);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 24px;
      padding: 80px 40px;
      transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1000;
    }

    .nav-menu.active {
      right: 0;
    }

    .nav-link {
      font-size: 1.2rem;
      width: 100%;
      text-align: center;
    }

    .nav-btn-mobile {
      display: inline-flex !important;
      width: 100%;
      margin-top: 16px;
    }

    .header-cta {
      display: none;
    }

    /* Hamburger Animation */
    .menu-toggle.active .bar:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .menu-toggle.active .bar:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle.active .bar:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }
</style>

<script>
  // Scrolled header style
  const header = document.querySelector('.main-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });

  // Mobile menu toggle
  const menuToggle = document.getElementById('menuToggle');
  const navMenu = document.getElementById('navMenu');

  menuToggle?.addEventListener('click', () => {
    menuToggle.classList.toggle('active');
    navMenu?.classList.toggle('active');
  });

  // Close mobile menu when a link is clicked
  const navLinks = document.querySelectorAll('.nav-link');
  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      menuToggle?.classList.remove('active');
      navMenu?.classList.remove('active');
    });
  });

  // Theme Toggle Mechanism
  const themeToggleBtn = document.getElementById('themeToggleBtn');
  themeToggleBtn?.addEventListener('click', () => {
    const htmlEl = document.documentElement;
    const currentTheme = htmlEl.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    
    htmlEl.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  });
</script>

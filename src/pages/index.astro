---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MetaSection from '../components/MetaSection.astro';
import Benefits from '../components/Benefits.astro';
import Permissions from '../components/Permissions.astro';
import NicheFocus from '../components/NicheFocus.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';

// Welcome to Help Chat Bot!
---

<Layout title="Help Chat Bot | Especialistas em Automação Inteligente">
	<Header />
	<main>
		<Hero />
		<MetaSection />
		<Benefits />
		<Permissions />
		<NicheFocus />
		<CTA />
	</main>
	<Footer />
	<WhatsAppWidget />
</Layout>

<style>
	main {
		overflow: hidden;
		width: 100%;
	}
</style>
